# ==========================================
# SERVER ENVIRONMENT CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.pages.dev

# ==========================================
# MONGODB DATABASE CONFIGURATION
# ==========================================
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.6ruwy2e.mongodb.net/pizza_delivery?retryWrites=true&w=majority

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET=pizza_delivery_super_secure_jwt_secret_token_2026_dev
JWT_EXPIRES_IN=7d

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ==========================================
# EMAIL SERVICE (GMAIL SMTP WITH APP PASSWORD)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="Zomato Pizza" <your-email@gmail.com>

# ==========================================
# ADMIN & INVENTORY ALERT SETTINGS
# ==========================================
ADMIN_EMAIL=admin@pizzadelivery.com
LOW_STOCK_THRESHOLD=20
CRON_SCHEDULE="0 * * * *"
